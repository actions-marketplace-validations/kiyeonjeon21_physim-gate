{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A pointer to a file produced by the run (video, log, trace, rosbag, ...).",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "name",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "higher_is_better",
        "lower_is_better"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Domain": {
      "enum": [
        "robotics",
        "autonomous_driving",
        "aerial",
        "generic"
      ],
      "title": "Domain",
      "type": "string"
    },
    "Environment": {
      "additionalProperties": false,
      "description": "The execution environment the run was produced in.",
      "properties": {
        "python": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform"
        },
        "machine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine"
        },
        "extra": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extra",
          "type": "object"
        }
      },
      "title": "Environment",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Failure",
      "type": "object"
    },
    "Identifier": {
      "additionalProperties": false,
      "description": "Identifies a scenario or a policy, optionally pinned to a version or checkpoint.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "Identifier",
      "type": "object"
    },
    "JsonValue": {},
    "MetricSpec": {
      "additionalProperties": false,
      "description": "Declares a metric: its unit and which direction is an improvement.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "direction"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Simulator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "Simulator",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where the code under test came from.",
      "properties": {
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty"
        }
      },
      "title": "Source",
      "type": "object"
    },
    "Trial": {
      "additionalProperties": false,
      "description": "One episode or trial.\n\n``trial_id`` names the trial *condition* (for example scenario variant and seed). Trials with\nthe same id in two runs are treated as matched pairs. Matching ids only mean the conditions\nwere intended to be the same. They do not imply bitwise-identical physics.",
      "properties": {
        "trial_id": {
          "minLength": 1,
          "title": "Trial Id",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "status": {
          "$ref": "#/$defs/TrialStatus",
          "default": "ok"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "duration_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "trial_id"
      ],
      "title": "Trial",
      "type": "object"
    },
    "TrialStatus": {
      "enum": [
        "ok",
        "failed",
        "timeout",
        "error"
      ],
      "title": "TrialStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A complete, self-describing record of one simulation run.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "domain": {
      "$ref": "#/$defs/Domain",
      "default": "generic"
    },
    "simulator": {
      "$ref": "#/$defs/Simulator"
    },
    "scenario": {
      "$ref": "#/$defs/Identifier"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "completed"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricSpec"
      },
      "title": "Metrics",
      "type": "object"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/Trial"
      },
      "title": "Trials",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "extra": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extra",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "simulator",
    "scenario",
    "metrics",
    "trials"
  ],
  "title": "RunResult",
  "type": "object"
}
